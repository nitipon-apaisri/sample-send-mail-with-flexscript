FLEX_MAIL_URL=https://<flex-host>/<send-mail-script>
FLEX_MAIL_ID=<mail profile id>
FLEX_MAIL_TOKEN=<secret>
FLEX_MAIL_TO=you@example.com   # default recipient (comma-separated format depends on your Flex instance)
FLEX_MAIL_CC=manager@example.com   # default CC, optional; a caller passing cc: '' sends no CC
APP_MODE=development   # anything other than "production" adds an ENV tag to the subject
